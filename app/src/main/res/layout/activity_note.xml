<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    tools:context=".NoteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/note_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button"
            app:srcCompat="@drawable/ic_note_back_24"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/note_editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Project notes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/note_share_button"
            style="@style/Widget.Realtimenotes.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/note_editor_share"
            android:visibility="gone"
            app:icon="@drawable/ic_note_share_24"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/note_editor_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/note_editor_input"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:enabled="false"
        android:gravity="start|top"
        android:hint="@string/note_editor_hint"
        android:inputType="textCapSentences|textMultiLine|textAutoCorrect"
        android:lineSpacingExtra="5dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:saveEnabled="false"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
